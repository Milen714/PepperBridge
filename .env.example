PEPPER_IP=192.168.1.122
ESP32_IP=192.168.1.150
ESP32_PORT=50005
# Set false for the Choregraphe virtual robot, which has no LEDs.
PEPPER_LEDS_ENABLED=true
# 127.0.0.1 if backend and bridge run on same host
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9999

# Audio input source: "rpi_i2s" (Pi 5 INMP441) or "esp32" (TCP stream from XIAO)
AUDIO_SOURCE=rpi_i2s
I2S_MIC_GAIN=2.0
# Optional: leave empty for auto-detection via ALSA default / adau7002
I2S_MIC_DEVICE_INDEX=
